# Supabase — opcional. Sem estas variáveis, a VeridIA roda em modo local
# (localStorage no navegador), ideal para desenvolvimento e demonstração.
# Preencha para persistir submissões em Postgres e habilitar o backoffice
# multi-dispositivo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: usada apenas no servidor (API routes / backoffice). Nunca exponha.
SUPABASE_SERVICE_ROLE_KEY=
